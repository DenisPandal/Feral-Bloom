<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/UpgradesMenu.uss?fileID=7433441132597879392&amp;guid=cd4dc60be3279e54fafb83dee7dce307&amp;type=3#UpgradesMenu" />
    <ui:VisualElement name="UpgradesOverlay" class="upgrades-overlay">
        <ui:VisualElement name="UpgradesInnerFrame" class="upgrades-frame">
            <ui:VisualElement name="UpgradesHeader" class="upgrades-header">
                <ui:VisualElement name="HeaderCenter" class="header-center">
                    <ui:VisualElement name="UpgradesTitleImage" class="upgrades-title-image" style="height: 189px; width: 393px;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="SlotsRow" class="slots-row">
                <ui:VisualElement name="Slot1" class="slot-card slot-unlocked">
                    <ui:VisualElement class="power-art-container">
                        <ui:VisualElement class="bloom-glow-aura" />
                        <ui:VisualElement class="bloom-flower">
                            <ui:Label text="✿" class="bloom-icon" />
                        </ui:VisualElement>
                        <ui:Label text="✦" class="particle particle-1" />
                        <ui:Label text="•" class="particle particle-2" />
                        <ui:Label text="✦" class="particle particle-3" />
                    </ui:VisualElement>
                    <ui:VisualElement class="slot-footer">
                        <ui:Label text="🌿" class="leaf-icon leaf-unlocked" />
